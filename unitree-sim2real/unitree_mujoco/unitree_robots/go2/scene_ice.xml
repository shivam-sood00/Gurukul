<mujoco model="go2 ice scene">
  <include file="go2.xml"/>

  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <!-- Ice material -->
    <texture type="2d" name="ice_texture" builtin="flat" rgb1="0.8 0.9 1.0" width="100" height="100"/>
    <material name="ice" texture="ice_texture" rgba="0.8 0.9 1.0 0.9" reflectance="0.8" shininess="0.9"/>
    
    <!-- Ice border material -->
    <material name="ice_border" rgba="0.6 0.7 0.9 1" reflectance="0.3" shininess="0.5"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Ice floor section with very low friction -->
    <geom name="ice_floor" pos="1.5 0 0.001" type="box" size="1.0 1.5 0.005" 
          material="ice" friction="0.08 0.04 0.002"/>
    
    <!-- Visual borders around ice -->
    <geom name="ice_border_1" pos="0.5 0 0.006" type="box" size="0.02 1.5 0.01" 
          material="ice_border"/>
    <geom name="ice_border_2" pos="2.5 0 0.006" type="box" size="0.02 1.5 0.01" 
          material="ice_border"/>
    <geom name="ice_border_3" pos="1.5 1.5 0.006" type="box" size="1.0 0.02 0.01" 
          material="ice_border"/>
    <geom name="ice_border_4" pos="1.5 -1.5 0.006" type="box" size="1.0 0.02 0.01" 
          material="ice_border"/>

    <!-- Ice warning signs (small visual markers) -->
    <geom name="warning_1" pos="0.3 1.2 0.02" type="cylinder" size="0.05 0.01" 
          rgba="1 1 0 1"/>
    <geom name="warning_2" pos="0.3 -1.2 0.02" type="cylinder" size="0.05 0.01" 
          rgba="1 1 0 1"/>
  </worldbody>
</mujoco>
