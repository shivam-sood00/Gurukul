<mujoco model="go2_with_arm ice scene">
  <include file="go2_with_arm.xml"/>

  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <!-- Ice material -->
    <texture type="2d" name="ice_texture" builtin="flat" rgb1="0.8 0.9 1.0" width="100" height="100"/>
    <material name="ice" texture="ice_texture" rgba="0.8 0.9 1.0 0.9" reflectance="0.8" shininess="0.9"/>
    
    <!-- Ice border material -->
    <material name="ice_border" rgba="0.6 0.7 0.9 1" reflectance="0.3" shininess="0.5"/>
    
    <!-- Terrain materials -->
    <material name="terrain_rock" rgba="0.5 0.4 0.3 1" reflectance="0.1" shininess="0.2"/>
    <material name="terrain_dirt" rgba="0.4 0.3 0.2 1" reflectance="0.05" shininess="0.1"/>
    
    <!-- Stair materials -->
    <material name="stair_up" rgba="0.3 0.3 0.3 1" reflectance="0.05" shininess="0.1"/>
    <material name="stair_down" rgba="0.4 0.4 0.4 1" reflectance="0.05" shininess="0.1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Ice floor section with reduced but still low friction for better traversability -->
    <geom name="ice_floor" pos="1.5 0 0.001" type="box" size="1.0 2.25 0.005" 
          material="ice" friction="0.12 0.08 0.004"/>
    
    <!-- Visual borders around ice -->
    <geom name="ice_border_1" pos="0.5 0 0.006" type="box" size="0.02 2.25 0.01" 
          material="ice_border"/>
    <geom name="ice_border_2" pos="2.5 0 0.006" type="box" size="0.02 2.25 0.01" 
          material="ice_border"/>
    <geom name="ice_border_3" pos="1.5 2.25 0.006" type="box" size="1.0 0.03 0.01" 
          material="ice_border"/>
    <geom name="ice_border_4" pos="1.5 -2.25 0.006" type="box" size="1.0 0.03 0.01" 
          material="ice_border"/>

    <!-- Ice warning signs (small visual markers) -->
    <geom name="warning_1" pos="0.3 1.2 0.02" type="cylinder" size="0.05 0.01" 
          rgba="1 1 0 1"/>
    <geom name="warning_2" pos="0.3 -1.2 0.02" type="cylinder" size="0.05 0.01" 
          rgba="1 1 0 1"/>

    <!-- UNEVEN TERRAIN SECTION (after ice) - Made more traversable -->
    <!-- Smaller rocks and obstacles -->
    <geom name="rock_1" pos="3.5 0.8 0.05" type="box" size="0.12 0.15 0.05" 
          material="terrain_rock" euler="0 0 0.3"/>
    <geom name="rock_2" pos="3.8 -0.5 0.08" type="ellipsoid" size="0.14 0.18 0.08" 
          material="terrain_rock"/>
    <geom name="rock_3" pos="4.1 0.3 0.04" type="box" size="0.10 0.12 0.04" 
          material="terrain_rock" euler="0 0 -0.2"/>
    <geom name="rock_4" pos="4.4 -0.8 0.06" type="cylinder" size="0.09 0.06" 
          material="terrain_rock"/>
    <geom name="rock_5" pos="4.7 0.6 0.05" type="box" size="0.08 0.18 0.05" 
          material="terrain_rock" euler="0 0 0.5"/>
    
    <!-- Gentler ground patches with reduced slopes -->
    <geom name="patch_1" pos="3.6 -0.2 0.02" type="box" size="0.3 0.375 0.02" 
          material="terrain_dirt" euler="0 0.05 0"/>
    <geom name="patch_2" pos="4.0 0.7 0.025" type="box" size="0.25 0.45 0.025" 
          material="terrain_dirt" euler="0 -0.04 0"/>
    <geom name="patch_3" pos="4.3 -0.3 0.02" type="box" size="0.35 0.3 0.02" 
          material="terrain_dirt" euler="0 0.06 0"/>
    <geom name="patch_4" pos="4.6 0.1 0.025" type="box" size="0.28 0.42 0.025" 
          material="terrain_dirt" euler="0 -0.03 0"/>
    
    <!-- Smaller bumps -->
    <geom name="bump_1" pos="3.7 0.0 0.015" type="capsule" size="0.09 0.12" 
          material="terrain_dirt" euler="1.57 0 0"/>
    <geom name="bump_2" pos="4.2 -0.6 0.02" type="capsule" size="0.075 0.10" 
          material="terrain_dirt" euler="1.57 0 0.8"/>
    <geom name="bump_3" pos="4.5 0.4 0.02" type="capsule" size="0.075 0.15" 
          material="terrain_dirt" euler="1.57 0 -0.4"/>
    
    <!-- Add transition ramps to make it easier to enter/exit this section -->
    <geom name="transition_ramp_1" pos="3.2 0 0.01" type="box" size="0.2 2.25 0.01" 
          material="terrain_dirt" euler="0 0.05 0"/>
    <geom name="transition_ramp_2" pos="5.0 0 0.02" type="box" size="0.2 2.25 0.02" 
          material="terrain_dirt" euler="0 -0.05 0"/>

    <!-- STAIRS SECTION - Reduced step height from 8cm to 5cm -->
    <!-- Ascending stairs with step height of 5 cm -->
    <geom name="stair_1" pos="5.5 0 0.025" type="box" size="0.15 3.0 0.025" material="stair_up"/>
    <geom name="stair_2" pos="5.8 0 0.075" type="box" size="0.15 3.0 0.025" material="stair_up"/>
    <geom name="stair_3" pos="6.1 0 0.125" type="box" size="0.15 3.0 0.025" material="stair_up"/>
    <geom name="stair_4" pos="6.4 0 0.175" type="box" size="0.15 3.0 0.025" material="stair_up"/>
    <geom name="stair_5" pos="6.7 0 0.225" type="box" size="0.15 3.0 0.025" material="stair_up"/>
    <geom name="stair_6" pos="7.0 0 0.275" type="box" size="0.15 3.0 0.025" material="stair_up"/>
    
    <!-- Platform at top -->
    <geom name="platform" pos="7.5 0 0.275" type="box" size="0.5 3.0 0.025" material="stair_up"/>
    
    <!-- Descending stairs -->
    <geom name="stair_d1" pos="8.0 0 0.225" type="box" size="0.15 3.0 0.025" material="stair_down"/>
    <geom name="stair_d2" pos="8.3 0 0.175" type="box" size="0.15 3.0 0.025" material="stair_down"/>
    <geom name="stair_d3" pos="8.6 0 0.125" type="box" size="0.15 3.0 0.025" material="stair_down"/>
    <geom name="stair_d4" pos="8.9 0 0.075" type="box" size="0.15 3.0 0.025" material="stair_down"/>
    <geom name="stair_d5" pos="9.2 0 0.025" type="box" size="0.15 3.0 0.025" material="stair_down"/>

    <!-- Section markers for navigation -->
    <geom name="marker_ice" pos="1.5 2.0 0.1" type="cylinder" size="0.02 0.05" 
          rgba="0 1 1 1"/>
    <geom name="marker_terrain" pos="4.0 2.0 0.1" type="cylinder" size="0.02 0.05" 
          rgba="0.6 0.4 0.2 1"/>
    <geom name="marker_stairs" pos="6.5 2.0 0.1" type="cylinder" size="0.02 0.05" 
          rgba="0.5 0.5 0.5 1"/>
  </worldbody>
</mujoco>
