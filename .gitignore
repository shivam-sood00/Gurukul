# Build, run, and training outputs
# ---------------------------------------------------------------------------
build/
install/
runs/
logs/
log/
*.log
output/
outputs/
recordings/
wandb/
.neptune/
artifacts/
*.tmp
*.pb
# Match contents rather than the directory itself so the website's checked-in
# placeholder stays reachable.
**/videos/*
!/website/static/videos/.gitkeep

# ---------------------------------------------------------------------------
# Large data artifacts
#
# Motion datasets are ignored by default; the collections that ship with the
# repository are re-included explicitly.
# ---------------------------------------------------------------------------
*.npz
!/source/Gurukul/Gurukul/tasks/manager_based/locomotion/velocity/config/humanoid/engineai_pm01/motion/locomotion.npz
!/source/Gurukul/Gurukul/tasks/manager_based/go2_apex/config/go2/motion/npz/go2_d1/*.npz
!/unitree-sim2real/RL_policy_runner/sim2real/apex_tracker_motions/*.npz

# ---------------------------------------------------------------------------
# Optional or redistribution-restricted research material
#
# Optional or redistribution-restricted research material stays excluded from
# the public repository at its established task and asset paths.
# ---------------------------------------------------------------------------
# Keep downloaded geometry and third-party motion collections excluded.
/source/Gurukul/data/Robots/unitree/go2_with_d1/meshes/d1/
/source/Gurukul/data/Robots/unitree/go2_with_d1/urdf/go2_d1_vis.urdf
/source/Gurukul/data/Robots/unitree/go2_with_d1/usd/d1/
/source/Gurukul/data/Robots/unitree/go2_with_d1/usd/*.usd
/source/Gurukul/data/Robots/unitree/go2_with_d1/usd/go2_d1_center_contact_pad_flat_corrected.usda
/unitree-sim2real/unitree_mujoco/unitree_robots/go2_with_d1/assets/
/source/Gurukul/Gurukul/tasks/manager_based/go2_apex/config/go2/motion/imitation_data/*
!/source/Gurukul/Gurukul/tasks/manager_based/go2_apex/config/go2/motion/imitation_data/go2_d1_motions_csv/
/source/Gurukul/Gurukul/tasks/manager_based/go2_apex/config/go2/motion/npz/*
!/source/Gurukul/Gurukul/tasks/manager_based/go2_apex/config/go2/motion/npz/go2_d1/
/source/Gurukul/Gurukul/tasks/manager_based/beyondmimic/config/g1/motion/*.csv
/source/Gurukul/Gurukul/tasks/direct/g1_amp/motions/*.csv
/source/robot_lab/robot_lab/tasks/manager_based/go2_apex/config/go2/motion/imitation_data/learn_diverse_quad_loco/

