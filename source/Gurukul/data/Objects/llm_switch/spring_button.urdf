<?xml version="1.0"?>
<!--
  Repository-authored spring-return push button for language-conditioned tasks.
  The button moves along +X, into the housing, through a 25 mm stroke.
-->
<robot name="llm_spring_button">
  <material name="housing_dark">
    <color rgba="0.08 0.09 0.11 1.0"/>
  </material>
  <material name="button_red">
    <color rgba="0.80 0.03 0.03 1.0"/>
  </material>

  <link name="housing">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.0182" ixy="0" ixz="0" iyy="0.0083" iyz="0" izz="0.0125"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.25 0.22"/>
      </geometry>
      <material name="housing_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.25 0.22"/>
      </geometry>
    </collision>
  </link>

  <link name="button">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.000054" ixy="0" ixz="0" iyy="0.000027" iyz="0" izz="0.000027"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="button_red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="button_joint" type="prismatic">
    <parent link="housing"/>
    <child link="button"/>
    <origin xyz="-0.08 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.025" effort="80.0" velocity="0.50"/>
    <dynamics damping="4.0" friction="0.2"/>
  </joint>
</robot>
